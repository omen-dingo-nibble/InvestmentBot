# ─────────────────────────────────────────────────────────────────────────────
# KKKPH Investment Bot — Configuration
# Copy this to .env locally, or set as Railway environment variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── Telegram ─────────────────────────────────────────────────────────────────
BOT_TOKEN=YOUR_BOT_TOKEN_HERE
BOT_USERNAME=italiaelitetradingbot

# Comma-separated Telegram user IDs with admin access
ADMIN_IDS=123456789,987654321

# ── Crypto wallet addresses ──────────────────────────────────────────────────
CRYPTO_BTC_ADDRESS=bc1qexampleexampleexampleexampleexample
CRYPTO_ETH_ADDRESS=0xExampleExampleExampleExampleExample
CRYPTO_USDT_TRC20_ADDRESS=TExampleExampleExampleExampleExample
CRYPTO_USDT_ERC20_ADDRESS=0xExampleExampleExampleExampleExample
CRYPTO_LTC_ADDRESS=ltc1qexampleexampleexampleexampleexample

# ── QR image filenames (relative to web/static/qr/) ─────────────────────────
QR_BTC=qr_btc.jpg
QR_ETH=qr_eth.jpg
QR_USDT_TRC20=qr_usdt_trc20.jpg
QR_USDT_ERC20=qr_usdt_erc20.jpg
QR_LTC=qr_ltc.jpg

# ── Currency / rates ─────────────────────────────────────────────────────────
DEFAULT_PHP_RATE=56.0
MIN_DEPOSIT_USD=10
MIN_WITHDRAWAL_USD=5
REFERRAL_BONUS_PERCENT=5
DEDUCT_REFERRAL_FROM_INVESTOR=false

# ── Blockchain verification (optional) ──────────────────────────────────────
AUTO_VERIFY_TX=false
BLOCKCHAIN_API_KEY=
BLOCKCHAIN_API_URL=https://api.blockchain.info/v2

# ── Database / file paths ────────────────────────────────────────────────────
# On Railway use a persistent volume: set DB_PATH=/data/bot.db
# and mount a volume at /data in your Railway service settings.
DB_PATH=data/bot.db
LOGS_DIR=logs

# ── Web panel ────────────────────────────────────────────────────────────────
# Railway injects PORT automatically — you don't need to set it.
# WEB_PORT is used as fallback when PORT is not set (local dev only).
WEB_HOST=0.0.0.0
WEB_PORT=5000

# REQUIRED: generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-this-to-a-long-random-secret-key-min-32-chars

# ── Railway-specific ─────────────────────────────────────────────────────────
# These are automatically injected by Railway — DO NOT set them manually.
# Documented here for reference:
#   PORT              — Railway sets this to the internal HTTP port
#   RAILWAY_ENVIRONMENT  — "production" on Railway; triggers ProxyFix + HTTPS cookies
#   REDIS_URL         — set if you add a Redis plugin; enables distributed rate limiting
#
# To add Redis on Railway:
#   1. Go to your project → New Service → Database → Redis
#   2. Link it to your bot service
#   3. Railway auto-injects REDIS_URL — no code changes needed

# ── Mirror site URLs (comma-separated, for invite links) ────────────────────
# SITE_URLS is read from DB settings (admin panel → Settings → Mirror Site URLs)
# You can also pre-configure it here via the DB seed if needed.

# ── Default web admin credentials ───────────────────────────────────────────
# Seeded on first run: username=admin  password=kkkphadmin
# CHANGE THE PASSWORD immediately after first login via /account
