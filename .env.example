# ─────────────────────────────────────────────────────────────────────────────
# High Caliber Construction NW — Investment Bot Configuration
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# Telegram bot credentials (get from @BotFather)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE
BOT_USERNAME=HCCNWBot

# Comma-separated Telegram user IDs that have admin access in the bot
ADMIN_IDS=123456789,987654321

# ── Crypto wallet addresses ─────────────────────────────────────────────────
# Users will be shown these addresses (+ QR codes) during the deposit flow.
CRYPTO_BTC_ADDRESS=bc1qexampleexampleexampleexampleexample
CRYPTO_ETH_ADDRESS=0xExampleExampleExampleExampleExample
CRYPTO_USDT_TRC20_ADDRESS=TExampleExampleExampleExampleExample
CRYPTO_USDT_ERC20_ADDRESS=0xExampleExampleExampleExampleExample
CRYPTO_LTC_ADDRESS=ltc1qexampleexampleexampleexampleexample

# ── QR code image filenames (placed in web/static/qr/) ─────────────────────
# Upload the QR images via the web admin Settings page, or place them
# manually at web/static/qr/<filename>.
QR_BTC=btc_qr.png
QR_ETH=eth_qr.png
QR_USDT_TRC20=usdt_trc20_qr.png
QR_USDT_ERC20=usdt_erc20_qr.png
QR_LTC=ltc_qr.png

# ── Currency settings ───────────────────────────────────────────────────────
# Default USD → PHP exchange rate (overridable in web admin Settings)
DEFAULT_PHP_RATE=56.0

# ── Operational settings ────────────────────────────────────────────────────
MIN_DEPOSIT_USD=10
MIN_WITHDRAWAL_USD=5
REFERRAL_BONUS_PERCENT=5
DEDUCT_REFERRAL_FROM_INVESTOR=false

# ── Blockchain monitor (optional) ───────────────────────────────────────────
# Set AUTO_VERIFY_TX=true only if you have a valid provider endpoint + key.
# When false (default), deposits are settled by admin approval.
AUTO_VERIFY_TX=false
BLOCKCHAIN_API_KEY=
BLOCKCHAIN_API_URL=https://api.blockchain.info/v2

# ── Paths ────────────────────────────────────────────────────────────────────
DB_PATH=data/bot.db
LOGS_DIR=logs

# ── Web Admin Panel ──────────────────────────────────────────────────────────
WEB_HOST=0.0.0.0
WEB_PORT=5000
FLASK_SECRET_KEY=change-this-to-a-long-random-secret-key

# Default web admin credentials (change immediately after first login!)
# Username: admin
# Password: hccnwadmin
